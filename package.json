{
  "name": "crimson-pc-check",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test scanner.test.js backend.test.js report-model.test.js runtime.test.js",
    "build:scanner": "node scripts/build-scanner.js",
    "test:scanner": "node scripts/build-scanner.js --test",
    "test:browser": "node scripts/test-browser.mjs",
    "prepare:hosted": "node scripts/prepare-hosted.mjs",
    "build:qr": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=esm --platform=browser --minify --outfile=vendor/qr.js"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  }
}
